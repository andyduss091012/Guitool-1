{
  "name": "guitool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Guitool - a vintage-metal styled guitar practice companion. Structured 60-minute daily practice sessions, an exercise library, progress tracking, and (soon) tuner, metronome, song practice and amp-tone tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "chords:build": "node scripts/build-chord-voicings.mjs",
    "data:parity": "node scripts/check-data-parity.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
