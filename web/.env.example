# Copy this file to `.env` (git-ignored) and fill in real values before
# running `docker compose up`. Nothing here is required to run the app —
# every variable has a safe default (imports just stay disabled) — but
# `docker compose` will read a `.env` in this folder automatically if
# you create one.

# Enables POST /admin/tabs/import and `npm run import:tab` against the
# tabs-server. Leave this unset/blank to keep admin import disabled (the
# default — see docker/tabs-server/lib/adminAuth.js). When you do set it,
# use a long random value and only share it with people you want to be
# able to add tabs to the shared library, e.g.:
#   openssl rand -hex 32
ADMIN_IMPORT_TOKEN=

# Read by the frontend at build time — the URL your BROWSER (not the
# container) can reach the tabs-server at. Only needs to change if you've
# moved the tabs-server off its default port or host.
VITE_TABS_SERVER_URL=http://localhost:4001
