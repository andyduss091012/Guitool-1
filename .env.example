# Copy to `.env` (git-ignored). Local development values only — never reuse them anywhere real.
# Read by the root docker-compose.yml.
POSTGRES_DB=guitarapp
POSTGRES_USER=guitarapp
POSTGRES_PASSWORD=guitarapp_dev
POSTGRES_PORT=5432
# Host port for the API container (docker compose up -d api).
API_PORT=5080

# The API reads its connection string from backend/src/GuitarApp.Api/appsettings.Development.json
# (copy appsettings.Development.example.json) or from the environment variable:
#   ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=guitarapp;Username=guitarapp;Password=guitarapp_dev
