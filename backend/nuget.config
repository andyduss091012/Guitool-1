<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Personal project: use ONLY nuget.org. <clear /> drops every source inherited from the
       user-level / machine-level NuGet.Config (e.g. a work Azure DevOps feed that needs credentials). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
